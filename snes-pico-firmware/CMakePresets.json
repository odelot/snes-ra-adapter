{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "pico",
      "hidden": false,
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build_pico",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_SDK_PATH": "C:\\VSARM\\sdk\\pico\\pico-sdk2",
        "PICO_BUILD": "ON",
        "PICO_PLATFORM": "rp2350-arm-s",
        "PICO_BOARD": "solderparty_rp2350_stamp_xl",
        "CMAKE_MAKE_PROGRAM": "C:\\VSARM\\mingw\\mingw32\\bin\\mingw32-make.exe"
      },
      "toolchainFile": "C:\\VSARM\\sdk\\pico\\pico-sdk2\\cmake\\preload\\toolchains\\pico_arm_cortex_m33_gcc.cmake"
    },
    {
      "name": "unit_tests",
      "hidden": false,
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build_tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UNIT_TESTS_BUILD": "ON",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_VERBOSE_MAKEFILE:BOOL": "ON",
        "HAVE_CLOCK_GETTIME": "0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build_pico",
      "configurePreset": "pico",
      "hidden": false
    },
    {
      "name": "build_tests",
      "configurePreset": "unit_tests",
      "hidden": false
    }
  ],
  "testPresets": [
    {
      "name": "test_all",
      "configurePreset": "unit_tests",
      "hidden": false
    }
  ]
}
